# AureusERP Configuration

# ==================== BANCO DE DADOS ====================
AUREUSRP_DB_PASSWORD=your_secure_postgres_password_here

# ==================== AUTHENTIK (SSO) ====================
OIDC_CLIENT_ID=aureusrp
OIDC_CLIENT_SECRET=your_oidc_client_secret_here

# ==================== SUPABASE ====================
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================== INTEGRATION SERVICE ====================
INTEGRATION_SERVICE_API_KEY=your_integration_api_key

# ==================== MERCADO PAGO (Opcional) ====================
MERCADO_PAGO_ACCESS_TOKEN=your_mp_access_token

# ==================== AMBIENTE ====================
NODE_ENV=production
LOG_LEVEL=info

# ==================== PORTAS ====================
# Porta interna (exposição local apenas para Traefik)
AUREUSRP_PORT=3000
AUREUSRP_DB_PORT=5432

# ==================== DOMÍNIOS ====================
# Será servido via: erp.focussdev.space (Traefik + Let's Encrypt)
