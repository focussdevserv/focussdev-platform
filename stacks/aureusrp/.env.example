# AureusERP + ERPNext Configuration

# ==================== ERPNEXT/FRAPPE ====================
FRAPPE_ADMIN_PASSWORD=your_secure_admin_password_here
SITE_NAME=erp.focussdev.space

# ==================== POSTGRESQL ====================
AUREUSRP_DB_PASSWORD=your_secure_postgres_password_here

# ==================== AUTHENTIK (OIDC SSO) ====================
# Criar application em Authentik:
# - Name: aureusrp
# - Client ID: aureusrp
# - Client Secret: (gerado automaticamente)
# - Redirect URIs: https://erp.focussdev.space/api/method/frappe.integrations.oauth2_logins.login_via_oauth2_id_provider

OIDC_CLIENT_ID=aureusrp
OIDC_CLIENT_SECRET=your_oidc_client_secret_from_authentik

# ==================== SUPABASE ====================
# Copiado de DeskcommCRM:
SUPABASE_URL=https://supabase.focussdev.space
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================== INTEGRATION SERVICE ====================
# Token de 64 caracteres hexadecimais (gerado na Checkpoint 07)
INTEGRATION_SERVICE_API_KEY=your_64_char_hex_api_key

# ==================== MERCADO PAGO (Futuro) ====================
# Será usado após Checkpoint 10
MERCADO_PAGO_ACCESS_TOKEN=your_mp_access_token_optional

# ==================== PORTAS ====================
# Porta interna (3001 local → 8000 ERPNext)
# Acessível via Traefik + HTTPS somente
AUREUSRP_PORT=3001
AUREUSRP_DB_PORT=5432
AUREUSRP_REDIS_PORT=6379

# ==================== DOMÍNIOS ====================
# Será servido via: erp.focussdev.space
# HTTPS automático via Traefik + Let's Encrypt
